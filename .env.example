# Airwallex sandbox (Account > Developer > API keys). Never commit real values.
AWX_CLIENT_ID=
AWX_API_KEY=
AWX_BASE_URL=https://api.sandbox.airwallex.com

# Metal testnet (console-testnet.metalntwx.com). Fund USDZ from the faucet.
# Metal testnet endpoint from https://console-testnet.metalntwx.com (the id in the URL is a credential).
# Platform keys (providers, bridge, gas sponsor) are files in data/metal/, written by npm run metal:setup.
# Each shop's agent keys and mandates live in data/shops/<shop>/metal/. Owner keys never touch the server.
METAL_RPC_URL=

# LLM used by the seller agent
ANTHROPIC_API_KEY=

# Mock inference providers (see /providers)
PROVIDER_CHEAP_URL=http://localhost:4101
PROVIDER_MID_URL=http://localhost:4102
PROVIDER_PREMIUM_URL=http://localhost:4103
# Window over which providers count paid calls to set their price (default 10 minutes)
# PROVIDER_DEMAND_WINDOW_MS=600000

# Ed25519 key that signs orders (npm run keys:order writes it to .env)
ORDER_SIGNING_KEY=

# Dashboard owner login (npm run keys:owner -- you@example.com writes all three)
OWNER_EMAIL=
OWNER_PASSWORD_HASH=
SESSION_SECRET=

# Buyer agents' storefront (Kit 10). PUBLIC_URL is this app's public https origin: Airwallex calls
# its checkout endpoint and the buyer's Claude signs in through its OAuth server.
# npm run kit10 -- setup writes AGENTIC_CHECKOUT_SECRET (the HMAC secret for checkout calls).
PUBLIC_URL=
AGENTIC_CHECKOUT_SECRET=
# Secret of the payment_intent.succeeded webhook (Airwallex web app > Developer > Webhooks)
AWX_WEBHOOK_SECRET=
# AWX_MCP_HOST=https://mcp.sandbox.airwallex.com
